    "/api/v1/tasks/{task_id}/transitions": {
      "post": {
        "tags": [
          "Transitions"
        ],
        "summary": "Transition Task",
        "description": "Execute a state transition for a task, verifying caller permissions and transition rules.\n\nAI agents can advance workflow states up to AWAITING_HUMAN_APPROVAL.\nDirect transitions to 'APPROVED' or 'COMPLETED' via /transitions are strictly blocked.",
        "operationId": "transition_task_api_v1_tasks__task_id__transitions_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          },
          {
            "name": "x-caller-type",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Caller-Type"
            }
          },
          {
            "name": "x-caller-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Caller-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransitionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{task_id}/approve": {
      "post": {
        "tags": [
          "Approval"
        ],
        "summary": "Approve Task",
        "description": "Human engineer approves proposed fix with verified Bearer token.\n\nTask must be in 'AWAITING_HUMAN_APPROVAL' status.\nStrictly forbidden for AI agents.",
        "operationId": "approve_task_api_v1_tasks__task_id__approve_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          },
          {
            "name": "x-caller-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
