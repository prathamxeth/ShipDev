      "post": {
        "tags": [
          "Approval"
        ],
        "summary": "Reject Task",
        "description": "Human engineer rejects proposed fix with feedback.\n\nTask must be in 'AWAITING_HUMAN_APPROVAL' status.\nTask returns to FIX_PROPOSED for the fix agent to re-attempt.",
        "operationId": "reject_task_api_v1_tasks__task_id__reject_post",
        "security": [
          {
