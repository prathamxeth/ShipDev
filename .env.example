# ShipDev Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Persistence
DATABASE_URL=sqlite:///./shipdev.db

# Frontend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Security Secrets
# API_SECRET_KEY: Used for machine-to-machine integrations (e.g. Switch agents)
API_SECRET_KEY=dev-agent-secret-change-in-production

# HUMAN_APPROVAL_SECRET: Strictly reserved for human authorization.
# MUST NOT be exposed to Switch agents, browser-side code, or public repositories.
HUMAN_APPROVAL_SECRET=dev-human-secret-change-in-production
