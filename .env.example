# ShipDev Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Persistence
DATABASE_URL=sqlite:///./shipdev.db

# Frontend CORS
FRONTEND_ORIGIN=http://localhost:3000

# Security Secrets
# API_SECRET_KEY: Used for machine-to-machine integrations (e.g. Switch agents).
# Must be explicitly configured with a strong secret. Fails closed (500) if unset.
# API_SECRET_KEY=replace-with-your-strong-agent-secret

# HUMAN_APPROVAL_SECRET: Strictly reserved for human authorization.
# Must be explicitly configured with a strong secret. Fails closed (500) if unset.
# MUST NOT be exposed to Switch agents, browser-side code, or public repositories.
# HUMAN_APPROVAL_SECRET=replace-with-your-strong-secret-key

# HUMAN_OPERATOR_IDENTITY: Server-derived operator identity recorded for human operations.
# Client-supplied reviewer attribution headers/payloads are ignored in favor of this identity.
HUMAN_OPERATOR_IDENTITY=shipdev-operator
