# ==============================================================================
# ShipDev Frontend Configuration (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public API Endpoint (Exposed to Browser)
# ------------------------------------------------------------------------------
# Base URL for read-only endpoints and task creation against Ayush's FastAPI backend.
# In local development: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. Canonical Application Origin (Server-Side Same-Origin & CSRF Defense)
# ------------------------------------------------------------------------------
# Canonical origin authorized to invoke state-changing human gate operations (/api/gate/*).
APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Local Operator Identity (Server-Side)
# ------------------------------------------------------------------------------
# Server-derived operator identity tag recorded during local human gate actions.
# Prevents client-side identity spoofing/impersonation.
LOCAL_OPERATOR_IDENTITY=local-operator

# ------------------------------------------------------------------------------
# 4. Cryptographic Human Gate Secret (STRICTLY SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# CAUTION: NEVER prefix this variable with NEXT_PUBLIC_.
# This secret is read strictly by Next.js Server Route Handlers (/api/gate/*)
# to authenticate human approval, rejection, and completion requests to the
# FastAPI backend via constant-time Bearer token verification.
#
# Must match settings.HUMAN_APPROVAL_SECRET in backend/.env.
# Configure a strong secret in your local .env.local file:
HUMAN_APPROVAL_SECRET=<set-your-server-side-human-approval-secret-here>
